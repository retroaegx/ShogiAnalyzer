# ShogiAnalyzer 設定テンプレート
#
# 初回起動時に、このファイルが同じフォルダに ".env" としてコピーされます（.env は git の管理外）。
# 設定を変えるときはその .env を編集し、アプリを再起動してください。
# 空欄の項目は既定値（または自動設定）になります。
# 同じ名前の環境変数が OS 側に設定されている場合は、そちらが優先されます。

# ------------------------------------------------------------
# 公開アドレス
# ------------------------------------------------------------

# 固定の公開アドレス（Cloudflare Tunnel などで用意したもの）
# 設定すると Quick Tunnel（毎回変わる trycloudflare.com のアドレス）は使わず、
# 起動時にこのアドレスを表示します。設定方法は README の「公開アドレスを固定する」を参照。
# 例: https://shogi-sample.f5.si
SHOGI_ANALYZER_PUBLIC_URL=

# SHOGI_ANALYZER_PUBLIC_URL が空のときに Quick Tunnel を使うか
# TRUE: 使う（毎回ランダムな https://….trycloudflare.com が発行される） / FALSE: 使わない（PC・LAN内だけで使う）
SHOGI_ANALYZER_TUNNEL=TRUE

# ------------------------------------------------------------
# パスワード保護
# ------------------------------------------------------------

# 初回起動時にコンソールで「有効にしますか？」と聞かれ、その答え（TRUE / FALSE）がここに書き込まれます。
# 空欄のまま起動すると、もう一度聞かれます。
# TRUE : 接続時にパスワードを求めます。一度入力すると、その端末・そのアドレスでは 30 日間入力不要です。
#        パスワードがまだ無いときは、最初に接続した画面で設定を求めます。
#        この PC 以外（スマホ・公開アドレス）から設定する場合は、起動時のコンソールに表示される
#        6 桁のセットアップコードも入力します（他人に先に設定されないため）。
# FALSE: パスワードなし。TRUE から FALSE に変えて起動すると、保存されていたパスワードは削除されます。
# ※ パスワードを忘れた / 変えたいときは、一度 FALSE で起動してから TRUE に戻すと設定し直せます。
# ※ Quick Tunnel はアドレスが毎回変わるため、アドレスが変わるたびに再入力が必要です
#   （固定アドレスなら 30 日間そのまま使えます）。
SHOGI_ANALYZER_PASSWORD=

# ------------------------------------------------------------
# 更新の確認
# ------------------------------------------------------------

# GitHub の最新リリースを確認し、新しいバージョンがあれば画面とコンソールでお知らせします
# TRUE: 確認する（起動時と、下の間隔ごと） / FALSE: 確認しない
SHOGI_ANALYZER_UPDATE_CHECK=TRUE

# 確認する間隔（時間）
SHOGI_ANALYZER_UPDATE_CHECK_INTERVAL_HOURS=24

# ------------------------------------------------------------
# サーバー
# ------------------------------------------------------------

# 待ち受けポート
SHOGI_ANALYZER_PORT=31145

# 待ち受けアドレス
# 127.0.0.1: この PC からのみ（Cloudflare Tunnel 経由の公開はこのままで使えます）
# 0.0.0.0  : 同じ LAN の別の PC / スマホからも http://このPCのIP:ポート で開けるようにする
#            ※ パスワード保護が FALSE のときは、同じネットワークの誰でも開けます。
SHOGI_ANALYZER_HOST=127.0.0.1

# コンソールに出すサーバーログの詳しさ: warning / info / debug
SHOGI_ANALYZER_SERVER_LOGLEVEL=warning

# ------------------------------------------------------------
# 解析エンジン（USI）
# ------------------------------------------------------------
# 空欄のまま起動すると、実際に使うエンジン（初回は自動で用意したやねうら王 + 水匠5）の
# パスがここに自動で書き込まれます。別のエンジンを使う場合はこの値を書き換えてください。
# 相対パスはこの .env があるフォルダからの位置になります。区切りは / でも \ でも可。
# 例: D:/shogi/engines/YaneuraOu/YaneuraOu_NNUE-tournament-clang++-avx2.exe
SHOGI_ANALYZER_ENGINE_PATH=

# 評価関数（nn.bin など）のフォルダ
# 空欄のまま起動すると、エンジンの exe の近くの "eval" フォルダを探して自動で書き込みます。
# 例: D:/shogi/engines/YaneuraOu/eval
SHOGI_ANALYZER_ENGINE_EVAL_DIR=

# スレッド数・ハッシュなどのエンジンオプションは、画面の「解析 ⚙」から設定してください
# （エンジンの既定値を読み取って表示します）。
